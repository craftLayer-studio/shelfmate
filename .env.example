# Public base URL used in QR codes and share links. Dev default: http://localhost:3157
APP_URL=https://shelfmate.craftlayer.store
# 32+ random characters. Signs the staff session cookie. Required when DEMO_MODE=off.
SESSION_SECRET=
# Postgres connection string. Leave empty to use the local PGlite file DB in ./.data/pglite.
DATABASE_URL=
# "off" hides demo OTPs on screen and disables simulated payment confirmation.
DEMO_MODE=on
